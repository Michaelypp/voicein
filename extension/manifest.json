{
  "manifest_version": 3,
  "name": "VoiceIn for Canvas",
  "version": "2.0.0",
  "description": "Private, cursor-aware voice typing for Canvas LMS.",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": [
    "*://*.instructure.com/*",
    "https://canvas.ucsc.edu/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.instructure.com/*",
        "https://canvas.ucsc.edu/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-dictation": {
      "suggested_key": { "default": "Alt+Shift+Space" },
      "description": "Start or stop VoiceIn dictation"
    }
  },
  "action": {
    "default_title": "VoiceIn settings",
    "default_popup": "popup.html"
  }
}

